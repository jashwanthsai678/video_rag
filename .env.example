# Copy this file to .env and fill in your key. Never commit the real .env file.

# API key for the LLM used to generate step-by-step explanations.
# Works with OpenRouter (default base URL below) or plain OpenAI.
VIDEORAG_LLM_API_KEY=your-api-key-here
VIDEORAG_LLM_BASE_URL=https://openrouter.ai/api/v1
VIDEORAG_LLM_MODEL=openai/gpt-4o-mini

# Set to false to skip generation entirely and get a plain list of matched
# moments instead of a written guide (no API key needed).
# VIDEORAG_LLM_ENABLED=true

# --- Common overrides. See video_rag/config.py for the full list. ---

# VIDEORAG_VIDEOS_DIR=videos
# VIDEORAG_DATA_DIR=data

# Retrieval. relevance_threshold is the one worth tuning: run
# `videorag eval` and use the score distribution it prints.
# VIDEORAG_TOP_K=8
# VIDEORAG_RELEVANCE_THRESHOLD=0.55
# VIDEORAG_KEYWORD_WEIGHT=0.6      # 0 disables BM25, leaving vector-only search
# VIDEORAG_VECTOR_WEIGHT=1.0

# Clip selection. Matches further apart than the gap become separate clips.
# VIDEORAG_CLUSTER_MAX_GAP=30
# VIDEORAG_CLIP_BUFFER_SECONDS=4
# VIDEORAG_MAX_CLIP_SECONDS=180

# Frame sampling. Raise SCENE_MIN_FRACTION to keep fewer frames (faster
# indexing, lower recall); lower it if subtle UI changes are being missed.
# VIDEORAG_FPS_EXTRACT=1
# VIDEORAG_SCENE_MIN_FRACTION=0.02
# VIDEORAG_SCENE_PIXEL_DELTA=25
# VIDEORAG_KEEP_FRAMES=false       # true to keep extracted frames for debugging

# Models
# VIDEORAG_WHISPER_MODEL=base      # tiny | base | small | medium | large-v3
# VIDEORAG_WHISPER_LANGUAGE=en     # empty to auto-detect
# VIDEORAG_OCR_LANGUAGES=en        # comma-separated, e.g. "en,hi"
# VIDEORAG_OCR_DUAL_PASS=false     # second OCR pass; ~2x slower indexing
